# Postgres (Neon). Use the -pooler host in serverless environments.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/forge?sslmode=require

ACCESS_TOKEN_SECRET=your-access-token-secret-here
REFRESH_TOKEN_SECRET=your-refresh-token-secret-here

# Image storage — set either Cloudinary or R2
CLOUDINARY_URL=cloudinary://key:secret@cloud-name
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=forge-media
# R2_PUBLIC_URL=
